# Frameworks/base patch for LineageOS 24.0 / Android 17.
# When startInput returns an InputBindResult with a duplicated InputChannel,
# the normal path transfers it to IInputMethodClientInvoker, which disposes
# the server-side copy in its finally block. If the client was unbound before
# delivery, no invoker is called and the duplicated channel must be disposed
# here to avoid leaking socket file descriptors in system_server.
# This patch is for android_frameworks_base, NOT the kernel source tree.
diff --git a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
--- a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
+++ b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
@@ -3941,6 +3941,9 @@
             } else {
                 // client is unbound.
                 Slog.i(TAG, "Client that requested startInputOrWindowGainedFocus is no longer"
                         + " bound. InputBindResult: " + res + " for startInputSeq: "
                         + startInputSeq);
+                if (res.channel != null) {
+                    res.channel.dispose();
+                }
             }
