From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SukiSU Patch Maintainer
Date: Wed, 14 Oct 2026 23:23:00 +0800
Subject: [PATCH] kernel: integrate SUSFS for Linux 5.4

Patch-Prepared: 2026-10-14
Subject: [PATCH] SukiSU: enable test-only UAPI v5

功能说明：
- 将 KERNEL_SU_UAPI_VERSION 更新至 5。
- 增加 BUNDLED build flag。
- 由 UAPI v5 提供 EVENT_SERVICES start/skip result 测试接口相关版本支持。

注意：
仅供测试版工作流使用。构建稳定版时，跳过此补丁的应用步骤。

---
diff --git a/kernel/include/uapi/supercall.h b/kernel/include/uapi/supercall.h
index 8274e3c..4932b41 100644
--- a/kernel/include/uapi/supercall.h
+++ b/kernel/include/uapi/supercall.h
@@ -13,7 +13,10 @@
 #endif
 
 // 2: allowlist v4 root profile flag
-DECLARE(__u32, KERNEL_SU_UAPI_VERSION, 2);
+// 3: scoped su-session driver fd
+// 4: bundled build flag
+// 5: EVENT_SERVICES start/skip result
+DECLARE(__u32, KERNEL_SU_UAPI_VERSION, 5);
 
 /* Magic numbers for reboot hook to install fd */
 DECLARE(__u32, KSU_INSTALL_MAGIC1, 0xDEADBEEF);
@@ -33,6 +36,7 @@ DECLARE(__u32, KSU_GET_INFO_FLAG_LKM, (1U << 0));
 DECLARE(__u32, KSU_GET_INFO_FLAG_MANAGER, (1U << 1));
 DECLARE(__u32, KSU_GET_INFO_FLAG_LATE_LOAD, (1U << 2));
 DECLARE(__u32, KSU_GET_INFO_FLAG_PR_BUILD, (1U << 3));
+DECLARE(__u32, KSU_GET_INFO_FLAG_BUNDLED, (1U << 4));
 
 struct ksu_get_info_cmd {
     __u32 version; /* Output: KERNEL_SU_VERSION */
diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
index 97368ae..0763c31 100644
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -20,6 +20,9 @@ static int do_get_info(void __user *arg)
     if (is_manager()) {
         cmd.flags |= KSU_GET_INFO_FLAG_MANAGER;
     }
+#ifndef MODULE
+    cmd.flags |= KSU_GET_INFO_FLAG_BUNDLED;
+#endif
 
     cmd.features = KSU_FEATURE_MAX;
     cmd.uapi_version = KERNEL_SU_UAPI_VERSION;
