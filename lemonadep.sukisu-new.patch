diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -1,3 +1,44 @@
+#include <asm/unistd.h>
+#include <linux/ksu_seccomp.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#endif
+
+/*
+ * Called by the Linux seccomp core before evaluating installed filters.
+ * Allow the exact KernelSU FD-install request and read-only SUSFS capability
+ * probes from UID 0; all other syscalls and reboot arguments remain
+ * subject to the inherited filter. SUSFS mutation commands are not exempted.
+ */
+bool ksu_seccomp_allow_reboot(const struct seccomp_data *sd)
+{
+	if (!sd || sd->nr != __NR_reboot)
+		return false;
+
+	if ((__u32)sd->args[0] != KSU_INSTALL_MAGIC1)
+		return false;
+
+	if ((__u32)sd->args[1] == KSU_INSTALL_MAGIC2)
+		return ksu_is_manager_appid_valid() && is_uid_manager(current_uid().val);
+
+#ifdef CONFIG_KSU_SUSFS
+	if ((__u32)sd->args[1] == SUSFS_MAGIC &&
+	    ((__u32)sd->args[2] == CMD_SUSFS_SHOW_VERSION ||
+	     (__u32)sd->args[2] == CMD_SUSFS_SHOW_ENABLED_FEATURES ||
+	     (__u32)sd->args[2] == CMD_SUSFS_SHOW_VARIANT)) {
+		/*
+		 * toolkit_handle_sys_reboot() dispatches SUSFS only for UID 0.
+		 * ksud may inherit the manager's seccomp filter after switching to
+		 * root, so checking the manager app UID here rejects the real probes.
+		 * Exempt root only, and only for these three read-only query commands.
+		 */
+		return !current_uid().val;
+	}
+#endif
+
+	return false;
+}
+
