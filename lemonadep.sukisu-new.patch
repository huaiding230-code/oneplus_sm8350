+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+/*
+ * Linux 5.4 keeps SELinux policy state in selinux_state.ss.  The OnePlus
+ * kernel patch redirects app-UID selinuxfs reads to this immutable view,
+ * while policy updates continue against the live state.
+ */
+#include <linux/user_namespace.h>
+#include <linux/vmalloc.h>
+#include <security.h>
+#include <ss/policydb.h>
+#include <ss/services.h>
+
+struct selinux_state fake_state;
+static struct selinux_ss fake_ss;
+static bool legacy_snapshot_ready;
+static DEFINE_MUTEX(legacy_snapshot_mutex);
+
+static void ksu_legacy_update_running(void)
+{
+    bool ready = smp_load_acquire(&legacy_snapshot_ready) &&
+        READ_ONCE(fake_ss.status_page);
+
+    WRITE_ONCE(ksu_selinux_hide_running,
+        ready && READ_ONCE(ksu_selinux_hide_enabled));
+}
+
+int ksu_selinux_hide_snapshot_legacy(void)
+{
+    struct selinux_ss *live_ss;
+    struct policy_file fp;
+    void *data = NULL;
+    size_t len = 0;
+    u32 generation;
+    int attempt;
+    int ret = -EAGAIN;
+
+    mutex_lock(&legacy_snapshot_mutex);
+    if (smp_load_acquire(&legacy_snapshot_ready)) {
+        ret = 0;
+        goto out;
+    }
+
+    live_ss = READ_ONCE(selinux_state.ss);
+    if (!live_ss || !selinux_initialized(&selinux_state))
+        goto out;
+
+    for (attempt = 0; attempt < 4; attempt++) {
+        read_lock(&live_ss->policy_rwlock);
+        generation = READ_ONCE(live_ss->latest_granting);
+        read_unlock(&live_ss->policy_rwlock);
+
+        /* Use SELinux's serializer so the snapshot retains the full policy ABI. */
+        ret = security_read_policy(&selinux_state, &data, &len);
+        if (ret)
+            goto out;
+        if (!data || !len) {
+            ret = -EINVAL;
+            goto out;
+        }
+
+        fp.data = data;
+        fp.len = len;
+        ret = policydb_read(&fake_ss.policydb, &fp);
+        if (!ret)
+            fake_ss.policydb.len = len;
+        vfree(data);
+        data = NULL;
+        if (ret) {
+            memset(&fake_ss.policydb, 0, sizeof(fake_ss.policydb));
+            goto out;
+        }
+
+        rwlock_init(&fake_ss.policy_rwlock);
+        mutex_init(&fake_ss.status_lock);
+        read_lock(&live_ss->policy_rwlock);
+        if (generation != READ_ONCE(live_ss->latest_granting)) {
+            read_unlock(&live_ss->policy_rwlock);
+            policydb_destroy(&fake_ss.policydb);
+            memset(&fake_ss.policydb, 0, sizeof(fake_ss.policydb));
+            ret = -EAGAIN;
+            continue;
+        }
+
+        fake_ss.sidtab = live_ss->sidtab;
+        fake_ss.latest_granting = live_ss->latest_granting;
+        fake_ss.map = live_ss->map;
+        fake_ss.status_page = READ_ONCE(ksu_fake_status_page);
+        fake_state = selinux_state;
+        fake_state.ss = &fake_ss;
+        fake_state.initialized = true;
+        smp_store_release(&legacy_snapshot_ready, true);
+        read_unlock(&live_ss->policy_rwlock);
+
+        pr_info("selinux_hide: saved original Linux 5.4 policy snapshot (%zu bytes)\n",
+            len);
+        ret = 0;
+        break;
+    }
+
+out:
+    vfree(data);
+    mutex_unlock(&legacy_snapshot_mutex);
+    ksu_legacy_update_running();
+    return ret;
+}
+
+struct selinux_state *ksu_selinux_hide_select_state(struct selinux_state *state)
+{
+    if (READ_ONCE(ksu_selinux_hide_running) &&
+        smp_load_acquire(&legacy_snapshot_ready) &&
+        READ_ONCE(fake_ss.status_page) &&
+        from_kuid(&init_user_ns, current_uid()) >= 10000)
+        return &fake_state;
+    return state;
+}
+EXPORT_SYMBOL_GPL(ksu_selinux_hide_select_state);
+#endif /* Linux 5.4 */
+#endif /* CONFIG_KSU_SUSFS */
