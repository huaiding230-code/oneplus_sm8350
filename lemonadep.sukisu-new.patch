diff --git a/kernel/extension/susfs_extension.c b/kernel/extension/susfs_extension.c
new file mode 100644
index 0000000000000000000000000000000000000000..8cf23ab374f2f73970497a8e772caf9aa6f3cee1
--- /dev/null
+++ b/kernel/extension/susfs_extension.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SuSFS extension handler stub.
+ *
+ * SuSFS has no sticky bit, no ioctl passthrough, and no
+ * force_extension= replay. Its presence is advertised by the
+ * mere fact that this handler is registered with the extension
+ * subsystem — the framework itself sets `supported = true`
+ * whenever a handler is found, and `ops->get` only fills the
+ * optional value field.
+ *
+ * The SuSFS sub-screen independently checks whether the SuSFS
+ * module is installed (via `ksud susfs status`) and prompts the
+ * user accordingly. No additional runtime probing is needed here.
+ */
+#include "susfs_extension.h"
+#include "../include/klog.h" // IWYU pragma: keep
+
+#include <linux/errno.h>
+
+int ksu_extension_susfs_get(u32 extension_id, u64 *value)
+{
+    if (value)
+        *value = 0;
+    return 0;
+}
+
+int ksu_extension_susfs_set(u32 extension_id, u64 value)
+{
+    return -EOPNOTSUPP;
+}
+
+int ksu_extension_susfs_io(u32 extension_id, void __user *arg)
+{
+    return -EOPNOTSUPP;
+}
+
+int ksu_extension_susfs_wipe(u32 extension_id)
+{
+    return -EOPNOTSUPP;
+}
+
+void ksu_extension_susfs_apply_forced(u32 extension_id, u64 value)
+{
+    /* No-op: SuSFS state is managed entirely by the userspace
+     * module management flow, not by force_extension=. */
+}
+
+const struct ksu_extension_handler_ops ksu_extension_susfs_ops = {
+    .get = ksu_extension_susfs_get,
+    .set = NULL,
+};
diff --git a/kernel/extension/susfs_extension.h b/kernel/extension/susfs_extension.h
new file mode 100644
index 0000000000000000000000000000000000000000..d2bdbf6f489001d12c22db4a835c9aa2bd184c1b
--- /dev/null
+++ b/kernel/extension/susfs_extension.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * SuSFS extension handler.
+ *
+ * This is a thin shim that bridges the kernel extension subsystem
+ * (kernel/extension/extension.c) with the SuSFS module. The
+ * extension framework sets `supported = true` whenever a handler
+ * is registered; ops->get only fills the optional value field.
+ *
+ * SuSFS has no sticky bit, no ioctl passthrough, and no
+ * force_extension= replay. The SuSFS sub-screen independently
+ * probes `ksud susfs status` to determine whether the module is
+ * actually installed.
+ */
+#ifndef __KSU_H_EXTENSION_SUSFS
+#define __KSU_H_EXTENSION_SUSFS
+
+#include <linux/types.h>
+
+#include "extension.h"
+
+int ksu_extension_susfs_get(u32 extension_id, u64 *value);
+int ksu_extension_susfs_set(u32 extension_id, u64 value);
+int ksu_extension_susfs_io(u32 extension_id, void __user *arg);
+int ksu_extension_susfs_wipe(u32 extension_id);
+void ksu_extension_susfs_apply_forced(u32 extension_id, u64 value);
+
+/* ops table consumed by ksu_register_extension_handler() in extension.c */
+extern const struct ksu_extension_handler_ops ksu_extension_susfs_ops;
+
+#endif /* __KSU_H_EXTENSION_SUSFS */
diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index d342d42aa6ae8ca8a1bc0fc6080332cfbb31e907..023d9ccc88f4cc44e4acef79d2bd3438262ec406 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -179,6 +179,97 @@ extern struct selinux_state selinux_state;
 #endif
 
 static struct page *ksu_fake_status_page __read_mostly = nullptr;
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+/* Compatibility adapter for the Linux 5.4 selinux_state/selinux_ss layout. */
+#include <linux/highmem.h>
+#include <linux/user_namespace.h>
+#include <linux/vmalloc.h>
+#include <ss/policydb.h>
+#include <ss/services.h>
+
+struct selinux_state fake_state;
+bool ksu_selinux_hide_running __read_mostly = false;
+static struct selinux_ss fake_ss;
+static bool legacy_snapshot_ready;
+static DEFINE_MUTEX(legacy_snapshot_mutex);
+static bool legacy_fake_ss_initialized;
+
+static void ksu_legacy_update_running(void)
+{
+	bool ready = READ_ONCE(legacy_snapshot_ready) &&
+		READ_ONCE(legacy_fake_ss_initialized) &&
+		READ_ONCE(fake_ss.status_page);
+
+	WRITE_ONCE(ksu_selinux_hide_running,
+		ready && READ_ONCE(ksu_selinux_hide_enabled));
+}
+
+int ksu_selinux_hide_snapshot_legacy(void)
+{
+	struct policy_file fp;
+	void *data = nullptr;
+	size_t len = 0;
+	int ret;
+
+	mutex_lock(&legacy_snapshot_mutex);
+	if (legacy_snapshot_ready) {
+		mutex_unlock(&legacy_snapshot_mutex);
+		return 0;
+	}
+	if (!selinux_state.ss || !selinux_initialized(&selinux_state)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	/* Linux 5.4 takes state explicitly; serialize the untouched live policy. */
+	ret = security_read_policy(&selinux_state, &data, &len);
+	if (ret)
+		goto out;
+	if (!data || !len) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	fp.data = data;
+	fp.len = len;
+	ret = policydb_read(&fake_ss.policydb, &fp);
+	if (ret)
+		goto out;
+
+	rwlock_init(&fake_ss.policy_rwlock);
+	mutex_init(&fake_ss.status_lock);
+	fake_ss.sidtab = selinux_state.ss->sidtab;
+	fake_ss.latest_granting = selinux_state.ss->latest_granting;
+	fake_ss.map = selinux_state.ss->map;
+	fake_ss.status_page = ksu_fake_status_page;
+	legacy_fake_ss_initialized = true;
+	fake_state = selinux_state;
+	fake_state.ss = &fake_ss;
+	fake_state.initialized = true;
+	WRITE_ONCE(legacy_snapshot_ready, true);
+	pr_info("selinux_hide: saved original Linux 5.4 policydb (%zu bytes)\n", len);
+	ret = 0;
+out:
+	vfree(data);
+	mutex_unlock(&legacy_snapshot_mutex);
+	if (ret)
+		pr_warn("selinux_hide: Linux 5.4 policy snapshot failed: %d\n", ret);
+	ksu_legacy_update_running();
+	return ret;
+}
+
+struct selinux_state *ksu_selinux_hide_select_state(struct selinux_state *state)
+{
+	if (READ_ONCE(ksu_selinux_hide_running) &&
+	    READ_ONCE(legacy_snapshot_ready) && READ_ONCE(fake_ss.status_page) &&
+	    from_kuid(&init_user_ns, current_uid()) >= 10000)
+		return &fake_state;
+	return state;
+}
+EXPORT_SYMBOL_GPL(ksu_selinux_hide_select_state);
+#endif /* LINUX_VERSION_CODE < 5.10 */
+
 static int ksu_prepare_fake_status_page()
 {
 	struct page *real_page = ksu_selinux_kernel_status_page();
@@ -207,6 +298,11 @@ static int ksu_prepare_fake_status_page()
 #endif
 
 	ksu_fake_status_page = new_page;
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+	if (legacy_fake_ss_initialized)
+		fake_ss.status_page = new_page;
+	ksu_legacy_update_running();
+#endif
     
 	pr_info("selinux_hide: ksu_fake_status_page ready! seq=%d\n", fake_status->sequence);
             
@@ -347,7 +443,9 @@ static int selinux_hide_feature_set(u64 value)
 		ksu_selinux_hide_enabled = true;
 	else
 		ksu_selinux_hide_enabled = false;
-
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+	ksu_legacy_update_running();
+#endif
 	return ret;
 }
 
@@ -372,6 +470,9 @@ void __init ksu_selinux_hide_init()
 
 void __exit ksu_selinux_hide_exit()
 {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+	WRITE_ONCE(ksu_selinux_hide_running, false);
+#endif
 	ksu_unregister_feature_handler(KSU_FEATURE_SELINUX_HIDE);
 }
 
