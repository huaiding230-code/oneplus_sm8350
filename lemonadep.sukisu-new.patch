@@ -54,21 +54,23 @@ static int crown_manager(const char *apk, const char *apk_dir, struct list_head
 {
 	struct list_head *list = (struct list_head *)uid_data;
 	struct uid_data *np;
+	char fallback_pkg[KSU_MAX_PACKAGE_NAME];
+	const char *builtin_pkg = KSU_PACKAGE_NAME;
 	bool builtin_present_this_call = false;
 	bool builtin_crowned_this_call = false;
 
 	if (sig_fallback) {
-		char pkg[KSU_MAX_PACKAGE_NAME];
-		if (get_pkg_from_apk_dir_path(pkg, apk_dir) < 0) {
+		if (get_pkg_from_apk_dir_path(fallback_pkg, apk_dir) < 0) {
 			pr_err("Failed to get package name from apk dir path: %s\n", apk_dir);
 			return 0;
 		}
+		builtin_pkg = fallback_pkg;
 
-		pr_info("manager pkg: %s\n", pkg);
+		pr_info("manager pkg: %s\n", fallback_pkg);
 
 		list_for_each_entry (np, list, list) {
-			if (test_extra_pkgs(np->package) || strncmp(np->package, pkg, KSU_MAX_PACKAGE_NAME) == 0) {
-				pr_info("Crowning manager: %s(uid=%d)\n", pkg, np->uid);
+			if (test_extra_pkgs(np->package) || strncmp(np->package, fallback_pkg, KSU_MAX_PACKAGE_NAME) == 0) {
+				pr_info("Crowning manager: %s(uid=%d)\n", fallback_pkg, np->uid);
 				ksu_set_manager_appid(np->uid);
 				state->builtin_crowned = true;
 				builtin_crowned_this_call = true;
@@ -103,7 +105,7 @@ static int crown_manager(const char *apk, const char *apk_dir, struct list_head
 		return 0;
 
 	list_for_each_entry (np, list, list) {
-		if (strncmp(np->package, KSU_PACKAGE_NAME, KSU_MAX_PACKAGE_NAME) == 0)
+		if (strncmp(np->package, builtin_pkg, KSU_MAX_PACKAGE_NAME) == 0)
 			continue;
 
 		if (ksu_dynamic_manager_verify_apk((char *)apk, np->package, np->uid)) {
diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index a9d4f67..2e3ff39 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -151,6 +151,11 @@ static int apply_kernelsu_rules_fn(void *ptr)
 void apply_kernelsu_rules()
 {
 	struct policydb *db;
