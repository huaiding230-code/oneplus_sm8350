diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -1,3 +1,42 @@
+#include <asm/unistd.h>
+#include <linux/audit.h>
+#include <linux/seccomp.h>
+
+/*
+ * Called by the Linux seccomp core before evaluating installed filters.
+ * Allow only the two reboot-syscall transports that the kernel intercepts:
+ * the manager's exact KernelSU FD handshake, and root-only SUSFS commands.
+ * Normal reboot requests and every other syscall remain filtered.
+ */
+bool ksu_seccomp_allow_reboot(const struct seccomp_data *sd)
+{
+	if (!sd || sd->nr != __NR_reboot ||
+	    (__u32)sd->args[0] != KSU_INSTALL_MAGIC1)
+		return false;
+
+#if defined(CONFIG_ARM64)
+	/* Do not exempt compat AArch32 syscall number 142 (_newselect). */
+	if (sd->arch != AUDIT_ARCH_AARCH64)
+		return false;
+#elif defined(CONFIG_ARM)
+	if (sd->arch != AUDIT_ARCH_ARM)
+		return false;
+#endif
+
+	if ((__u32)sd->args[1] == KSU_INSTALL_MAGIC2)
+		/* ksud also obtains its initial driver FD while running as root.
+		 * is_uid_manager() already covers both static and dynamic managers.
+		 */
+		return current_uid().val == 0 || is_uid_manager(current_uid().val);
+
+#ifdef CONFIG_KSU_SUSFS
+	if ((__u32)sd->args[1] == SUSFS_MAGIC)
+		return current_uid().val == 0;
+#endif
+
+	return false;
+}
