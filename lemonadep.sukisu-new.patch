+/*
+ * Kernel-side counterparts for the OnePlus 5.4 SUSFS inline hooks.
+ * Unlike the userspace hooks, these receive a kernel struct filename.
+ * Return 1 only when the su path was actually rewritten to /system/bin/sh.
+ */
+static __always_inline int ksu_sucompat_kernel_path_common(struct filename **filename_ptr,
+						 const char *syscall_name)
+{
+	struct filename *filename;
+	char *path;
+	constexpr char sh[16] = SH_PATH;
+
+	if (!filename_ptr || IS_ERR_OR_NULL(*filename_ptr))
+		return 0;
+	filename = *filename_ptr;
+	if (!filename->name || !is_su_allowed((const void **)&filename->name))
+		return 0;
+
+	path = (char *)filename->name;
+	if (strncmp(path, SU_PATH, sizeof(SU_PATH)) &&
+	    strncmp(path, SU_PATH_ALT, sizeof(SU_PATH_ALT)))
+		return 0;
+
+	if (!strcmp(syscall_name, "sys_faccessat"))
+		write_sulog('a');
+	else if (!strcmp(syscall_name, "sys_newfstatat"))
+		write_sulog('s');
+
+	memcpy_inline(path, sh, sizeof(sh));
+	pr_info("su_compat: %s su->sh [kernel filename]%s\n", syscall_name,
+		is_compat_task() ? " [compat]" : "");
+	return 1;
+}
+
+int ksu_handle_faccessat_kernel(int *dfd, struct filename **filename_ptr,
+				int *mode, int *flags)
+{
+	return ksu_sucompat_kernel_path_common(filename_ptr, "sys_faccessat");
+}
+
+int ksu_handle_stat_kernel(int *dfd, struct filename **filename_ptr, int *flags)
+{
+	return ksu_sucompat_kernel_path_common(filename_ptr, "sys_newfstatat");
+}
+
 #else /* LINUX_VERSION_CODE < KERNEL_VERSION(3, 14, 0) */
 
