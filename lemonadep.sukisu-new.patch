index 1706e6f..3e3f52c 100644
--- a/kernel/feature/selinux_hide.h
+++ b/kernel/feature/selinux_hide.h
@@ -16,8 +16,15 @@
 #ifndef __KSU_H_SELINUX_HIDE
 #define __KSU_H_SELINUX_HIDE
 
+#include <linux/version.h>
+
 void ksu_selinux_hide_init();
 void ksu_selinux_hide_exit();
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+int ksu_selinux_hide_snapshot_legacy(void);
+struct selinux_state;
+struct selinux_state *ksu_selinux_hide_select_state(struct selinux_state *state);
+#endif
 
 static int sepol_expected_argc(u32 cmd);
 
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 9257980..485b5b1 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -1,3 +1,23 @@
+#include <asm/unistd.h>
+#include <linux/ksu_seccomp.h>
+
+/*
+ * Called by the Linux seccomp core before evaluating installed filters.
+ * Only the manager's exact reboot-based KernelSU FD request may pass; all
+ * other syscalls and reboot arguments remain subject to the inherited filter.
+ */
+bool ksu_seccomp_allow_reboot(const struct seccomp_data *sd)
+{
+	if (!sd || sd->nr != __NR_reboot)
+		return false;
+
+	if ((__u32)sd->args[0] != KSU_INSTALL_MAGIC1 ||
+	    (__u32)sd->args[1] != KSU_INSTALL_MAGIC2)
+		return false;
+
+	return ksu_is_manager_appid_valid() && is_uid_manager(current_uid().val);
+}
+
 static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const struct cred *old)
 {
 	if (!new || !old)
@@ -13,10 +33,14 @@ static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const st
 	if (IS_ENABLED(CONFIG_KSU_DEBUG))
 		pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
 
-	// we dont have those new fancy things upstream has
-	// lets just do the original thing where we disable seccomp
-	if (unlikely(is_uid_manager(new_uid)))
-		goto install_ksu_fd;
+	// Preserve the manager's inherited seccomp filter. The kernel seccomp core
+	// exempts only the exact reboot-based KernelSU FD request.
+	if (unlikely(is_uid_manager(new_uid))) {
+		pr_info("install fd for manager: %d\n", new_uid);
+		ksu_install_fd();
+		set_thread_flag(TIF_KSU_MANAGED); // sucompat fast-path
+		return;
+	}
 
 	if (ksu_is_allow_uid_for_current(new_uid))
 		goto kill_seccomp;
@@ -25,10 +49,6 @@ static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const st
 	ksu_handle_umount(new, old);
 	return;
 
-install_ksu_fd:
-	pr_info("install fd for manager: %d\n", new_uid);
-	ksu_install_fd();
-
 kill_seccomp:
 	disable_seccomp();
 	set_thread_flag(TIF_KSU_MANAGED); // sucompat fast-path
