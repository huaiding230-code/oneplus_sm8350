diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index d342d42aa6ae8ca8a1bc0fc6080332cfbb31e907..023d9ccc88f4cc44e4acef79d2bd3438262ec406 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -179,6 +179,97 @@ extern struct selinux_state selinux_state;
 #endif
 
 static struct page *ksu_fake_status_page __read_mostly = nullptr;
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+/* Compatibility adapter for the Linux 5.4 selinux_state/selinux_ss layout. */
+#include <linux/highmem.h>
+#include <linux/user_namespace.h>
+#include <linux/vmalloc.h>
+#include <ss/policydb.h>
+#include <ss/services.h>
+
+struct selinux_state fake_state;
+bool ksu_selinux_hide_running __read_mostly = false;
+static struct selinux_ss fake_ss;
+static bool legacy_snapshot_ready;
+static DEFINE_MUTEX(legacy_snapshot_mutex);
+static bool legacy_fake_ss_initialized;
+
+static void ksu_legacy_update_running(void)
+{
+	bool ready = READ_ONCE(legacy_snapshot_ready) &&
+		READ_ONCE(legacy_fake_ss_initialized) &&
+		READ_ONCE(fake_ss.status_page);
+
+	WRITE_ONCE(ksu_selinux_hide_running,
+		ready && READ_ONCE(ksu_selinux_hide_enabled));
+}
+
+int ksu_selinux_hide_snapshot_legacy(void)
+{
+	struct policy_file fp;
+	void *data = nullptr;
+	size_t len = 0;
+	int ret;
+
+	mutex_lock(&legacy_snapshot_mutex);
+	if (legacy_snapshot_ready) {
+		mutex_unlock(&legacy_snapshot_mutex);
+		return 0;
+	}
+	if (!selinux_state.ss || !selinux_initialized(&selinux_state)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	/* Linux 5.4 takes state explicitly; serialize the untouched live policy. */
+	ret = security_read_policy(&selinux_state, &data, &len);
+	if (ret)
+		goto out;
+	if (!data || !len) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	fp.data = data;
+	fp.len = len;
+	ret = policydb_read(&fake_ss.policydb, &fp);
+	if (ret)
+		goto out;
+
+	rwlock_init(&fake_ss.policy_rwlock);
+	mutex_init(&fake_ss.status_lock);
+	fake_ss.sidtab = selinux_state.ss->sidtab;
+	fake_ss.latest_granting = selinux_state.ss->latest_granting;
+	fake_ss.map = selinux_state.ss->map;
+	fake_ss.status_page = ksu_fake_status_page;
+	legacy_fake_ss_initialized = true;
+	fake_state = selinux_state;
+	fake_state.ss = &fake_ss;
+	fake_state.initialized = true;
+	WRITE_ONCE(legacy_snapshot_ready, true);
+	pr_info("selinux_hide: saved original Linux 5.4 policydb (%zu bytes)\n", len);
+	ret = 0;
+out:
+	vfree(data);
+	mutex_unlock(&legacy_snapshot_mutex);
+	if (ret)
+		pr_warn("selinux_hide: Linux 5.4 policy snapshot failed: %d\n", ret);
+	ksu_legacy_update_running();
+	return ret;
+}
+
+struct selinux_state *ksu_selinux_hide_select_state(struct selinux_state *state)
+{
+	if (READ_ONCE(ksu_selinux_hide_running) &&
+	    READ_ONCE(legacy_snapshot_ready) && READ_ONCE(fake_ss.status_page) &&
+	    from_kuid(&init_user_ns, current_uid()) >= 10000)
+		return &fake_state;
+	return state;
+}
+EXPORT_SYMBOL_GPL(ksu_selinux_hide_select_state);
+#endif /* LINUX_VERSION_CODE < 5.10 */
+
