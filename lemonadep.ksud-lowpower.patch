+fn state_change_watcher() -> Result<File> {
+    // The temporary-root state is atomically replaced in this directory.
+    // Watch directory events so lease changes wake the worker without polling.
+    let _dir = state_dir()?;
+    let fd = unsafe { libc::inotify_init1(libc::IN_CLOEXEC | libc::IN_NONBLOCK) };
+    if fd < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    let watcher = unsafe { File::from_raw_fd(fd) };
+    let path = CString::new(DIR)?;
+    let mask = libc::IN_CREATE | libc::IN_DELETE | libc::IN_CLOSE_WRITE | libc::IN_MOVED_TO;
+    if unsafe { libc::inotify_add_watch(watcher.as_raw_fd(), path.as_ptr(), mask) } < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    Ok(watcher)
+}
