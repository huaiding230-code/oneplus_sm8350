+fn wait_for_lease_change(watcher: &File, deadline: u64) -> Result<()> {
+    // CLOCK_BOOTTIME matches lease deadlines and advances across device suspend.
+    // This is a non-wakeup timer: it never wakes the phone just to revoke a lease.
+    let timer_fd = unsafe {
+        libc::timerfd_create(
+            libc::CLOCK_BOOTTIME,
+            libc::TFD_CLOEXEC | libc::TFD_NONBLOCK,
+        )
+    };
+    if timer_fd < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    let timer = unsafe { File::from_raw_fd(timer_fd) };
+    let spec = libc::itimerspec {
+        it_interval: libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        },
+        it_value: libc::timespec {
+            tv_sec: deadline as libc::time_t,
+            tv_nsec: 0,
+        },
+    };
+    if unsafe {
+        libc::timerfd_settime(
+            timer.as_raw_fd(),
+            libc::TFD_TIMER_ABSTIME,
+            &spec,
+            std::ptr::null_mut(),
+        )
+    } < 0
+    {
+        return Err(std::io::Error::last_os_error().into());
+    }
+
+    let mut fds = [
+        libc::pollfd {
+            fd: watcher.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        },
+        libc::pollfd {
+            fd: timer.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        },
+    ];
+
+    loop {
+        let ret = unsafe { libc::poll(fds.as_mut_ptr(), fds.len() as libc::nfds_t, -1) };
+        if ret < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == std::io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(error.into());
+        }
+
+        if fds[0].revents & libc::POLLIN != 0 {
+            // Drain all queued inotify records before recomputing the schedule.
+            let mut buffer = [0u8; 4096];
+            loop {
+                let count = unsafe {
+                    libc::read(
+                        watcher.as_raw_fd(),
+                        buffer.as_mut_ptr().cast(),
+                        buffer.len(),
+                    )
+                };
+                if count > 0 {
+                    continue;
+                }
+                if count == 0 {
+                    break;
+                }
+                let error = std::io::Error::last_os_error();
+                if error.kind() == std::io::ErrorKind::Interrupted {
+                    continue;
+                }
+                if error.kind() == std::io::ErrorKind::WouldBlock {
+                    break;
+                }
+                return Err(error.into());
+            }
+            return Ok(());
+        }
+
+        if fds[1].revents & libc::POLLIN != 0 {
+            let mut expirations = 0u64;
+            let count = unsafe {
+                libc::read(
+                    timer.as_raw_fd(),
+                    (&mut expirations as *mut u64).cast(),
+                    std::mem::size_of::<u64>(),
+                )
+            };
+            if count < 0 {
+                let error = std::io::Error::last_os_error();
+                if error.kind() == std::io::ErrorKind::Interrupted
+                    || error.kind() == std::io::ErrorKind::WouldBlock
+                {
+                    continue;
+                }
+                return Err(error.into());
+            }
+            return Ok(());
+        }
+
+        if (fds[0].revents | fds[1].revents)
+            & (libc::POLLERR | libc::POLLHUP | libc::POLLNVAL)
+            != 0
+        {
+            bail!("temporary-root watcher poll failed");
+        }
+    }
+}
