@@ -0,0 +1,57 @@
+/// Compute the next watcher retry/lease deadline without scheduling in the past.
+///
+/// Expired leases that failed revocation remain in the state file. Their stored
+/// deadline must not be reused as the next timer deadline, or timerfd becomes
+/// immediately readable and the watcher spins instead of waiting for retry.
+pub fn next_deadline(
+    now: u64,
+    retry_failed_revoke: bool,
+    lease_deadlines: impl IntoIterator<Item = u64>,
+) -> u64 {
+    let retry_deadline = retry_failed_revoke.then_some(now.saturating_add(60));
+    let next_lease_deadline = lease_deadlines
+        .into_iter()
+        .filter(|deadline| *deadline > now)
+        .min();
+
+    retry_deadline
+        .into_iter()
+        .chain(next_lease_deadline)
+        .min()
+        .unwrap_or_else(|| now.saturating_add(86400))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::next_deadline;
+
+    #[test]
+    fn failed_expired_lease_retries_after_sixty_seconds() {
+        assert_eq!(next_deadline(100, true, [50]), 160);
+    }
+
+    #[test]
+    fn earlier_live_lease_expiry_precedes_retry() {
+        assert_eq!(next_deadline(100, true, [130, 250]), 130);
+    }
+
+    #[test]
+    fn retry_precedes_later_live_lease_expiry() {
+        assert_eq!(next_deadline(100, true, [200]), 160);
+    }
+
+    #[test]
+    fn no_timed_leases_uses_daily_recovery_timeout() {
+        assert_eq!(next_deadline(100, false, []), 86500);
+    }
+
+    #[test]
+    fn retry_without_timed_leases_uses_sixty_seconds() {
+        assert_eq!(next_deadline(100, true, []), 160);
+    }
+
+    #[test]
+    fn deadlines_saturate_instead_of_overflowing() {
+        assert_eq!(next_deadline(u64::MAX - 5, true, [u64::MAX]), u64::MAX);
+    }
+}
