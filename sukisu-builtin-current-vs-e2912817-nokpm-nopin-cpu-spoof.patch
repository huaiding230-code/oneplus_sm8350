+        .cmd = KSU_IOCTL_SET_SPOOF_CPU,
+        .name = "SET_SPOOF_CPU",
+        .handler = do_set_spoof_cpu,
+        .perm_check = only_root
+    },
     {
         .cmd = KSU_IOCTL_GET_FULL_VERSION,
         .name = "GET_FULL_VERSION",
