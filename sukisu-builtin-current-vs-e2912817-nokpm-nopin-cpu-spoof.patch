diff --git a/kernel/feature/cpu_spoof.c b/kernel/feature/cpu_spoof.c
new file mode 100644
index 0000000..064510f
--- /dev/null
+++ b/kernel/feature/cpu_spoof.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/cpumask.h>
+#include <linux/percpu.h>
+#include <linux/jiffies.h>
+#include <linux/delay.h>
+#include <linux/clocksource.h>
+#include <linux/errno.h>
+#include <linux/kallsyms.h>
+#include "cpu_spoof.h"
+#include "klog.h"
+
+#if defined(CONFIG_ARM64) || defined(__aarch64__)
+#include <asm/cpu.h>
+#include <asm/cputype.h>
+#include <asm/cpufeature.h>
+#include <vdso/datapage.h>
+#include <vdso/clocksource.h>
+#ifndef MIDR_PARTNUM_SHIFT
+#define MIDR_PARTNUM_SHIFT 4
+#endif
+#ifndef MIDR_PARTNUM_MASK
+#define MIDR_PARTNUM_MASK (0xfff << MIDR_PARTNUM_SHIFT)
+#endif
+#ifndef MIDR_PARTNUM
+#define MIDR_PARTNUM(midr) (((midr) & MIDR_PARTNUM_MASK) >> MIDR_PARTNUM_SHIFT)
+#endif
+#ifndef ARM_CPU_PART_NEOVERSE_N1
+#define ARM_CPU_PART_NEOVERSE_N1 0xd0c
+#endif
+#ifndef ARM_CPU_PART_CORTEX_A76
+#define ARM_CPU_PART_CORTEX_A76 0xd0b
+#endif
+#ifndef QCOM_CPU_PART_KRYO_4XX_GOLD
+#define QCOM_CPU_PART_KRYO_4XX_GOLD 0x804
+#endif
+#ifndef CS_HRES_COARSE
+#define CS_HRES_COARSE 0
+#endif
+#ifndef CS_RAW
+#define CS_RAW 1
+#endif
+#ifndef VDSO_CLOCKMODE_ARCHTIMER
+#define VDSO_CLOCKMODE_ARCHTIMER 1
+#endif
+#ifndef ARM64_WORKAROUND_1418040
+#define ARM64_WORKAROUND_1418040 37
+#endif
+#endif
+
+/*
+ * This code is linked into vmlinux by the builtin SukiSU integration.
+ * kallsyms_lookup_name() is therefore callable without module exports. Data
+ * symbols require CONFIG_KALLSYMS_ALL=y to be present in the lookup table.
+ */
+static unsigned long ksu_cpu_spoof_lookup_symbol(const char *name)
+{
+#ifdef CONFIG_KALLSYMS
+    return kallsyms_lookup_name(name);
+#else
+    return 0;
+#endif
+}
+
+int ksu_set_spoof_cpu(const struct ksu_set_spoof_cpu_cmd *cmd)
+{
+    if (!cmd)
+        return -EINVAL;
+
+    /* Check both the logical CPU range and its possible-CPU mask bit. */
+    if (cmd->cpu_index >= nr_cpu_ids || !cpu_possible(cmd->cpu_index)) {
+        pr_warn("ksu: set_spoof_cpu invalid cpu_index %u\n", cmd->cpu_index);
+        return -EINVAL;
+    }
+
+#if defined(CONFIG_ARM64) || defined(__aarch64__)
+    /* Update the cached MIDR for the requested logical CPU. */
+    {
+        unsigned long cpu_data_base = ksu_cpu_spoof_lookup_symbol("cpu_data");
+        struct cpuinfo_arm64 *info;
+
+        if (!cpu_data_base) {
+            pr_err("ksu: set_spoof_cpu cannot resolve 'cpu_data'; check CONFIG_KALLSYMS_ALL\n");
+            return -ENOENT;
+        }
+
+        info = per_cpu_ptr((struct cpuinfo_arm64 *)cpu_data_base, cmd->cpu_index);
+        if (!info)
+            return -EINVAL;
+        info->reg_midr = cmd->midr;
+    }
+
+    /* These fields are system-wide, so change them once when CPU 0 is set. */
+    if (cmd->cpu_index == 0) {
+        unsigned long *lpj = (unsigned long *)ksu_cpu_spoof_lookup_symbol("loops_per_jiffy");
+        unsigned long *elf_hwcap = (unsigned long *)ksu_cpu_spoof_lookup_symbol("elf_hwcap");
+        unsigned long *elf_hwcap2 = (unsigned long *)ksu_cpu_spoof_lookup_symbol("elf_hwcap2");
+
+        if (lpj) {
+            pr_info("ksu: set_spoof_cpu current loops_per_jiffy: %lu\n", *lpj);
+            *lpj = ((unsigned long)cmd->bogomips * 500000) / (100 * HZ);
+            pr_info("ksu: set_spoof_cpu updated loops_per_jiffy: %lu\n", *lpj);
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'loops_per_jiffy'\n");
+        }
+
+        if (elf_hwcap && elf_hwcap2) {
+            pr_info("ksu: set_spoof_cpu current elf_hwcap: 0x%lx, elf_hwcap2: 0x%lx\n",
+                    *elf_hwcap, *elf_hwcap2);
+            *elf_hwcap = (unsigned long)cmd->hwcap;
+            *elf_hwcap2 = (unsigned long)cmd->hwcap2;
+            pr_info("ksu: set_spoof_cpu updated elf_hwcap: 0x%lx, elf_hwcap2: 0x%lx\n",
+                    *elf_hwcap, *elf_hwcap2);
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'elf_hwcap' or 'elf_hwcap2'\n");
+        }
+
+        /* Align vDSO clock modes only for parts outside the known list. */
+        {
+            unsigned int part = MIDR_PARTNUM(cmd->midr);
+
+            if (part != ARM_CPU_PART_NEOVERSE_N1 && part != ARM_CPU_PART_CORTEX_A76 &&
+                part != QCOM_CPU_PART_KRYO_4XX_GOLD) {
+                struct vdso_data **vdso_data_ptr =
+                    (struct vdso_data **)ksu_cpu_spoof_lookup_symbol("vdso_data");
+
+                if (vdso_data_ptr && *vdso_data_ptr) {
+                    struct vdso_data *vdso = *vdso_data_ptr;
+
+                    pr_info("ksu: set_spoof_cpu found 'vdso_data' (clock_mode: %d)\n",
+                            vdso[CS_HRES_COARSE].clock_mode);
+                    vdso[CS_HRES_COARSE].clock_mode = VDSO_CLOCKMODE_ARCHTIMER;
+                    vdso[CS_RAW].clock_mode = VDSO_CLOCKMODE_ARCHTIMER;
+                } else {
+                    pr_warn("ksu: set_spoof_cpu failed to resolve 'vdso_data'\n");
+                }
+
+                {
+                    struct clocksource **curr_cs_ptr =
+                        (struct clocksource **)ksu_cpu_spoof_lookup_symbol("curr_clocksource");
+
+                    if (curr_cs_ptr && *curr_cs_ptr) {
+                        struct clocksource *cs = *curr_cs_ptr;
+
+                        pr_info("ksu: set_spoof_cpu found active clocksource '%s' (vdso_clock_mode: %d)\n",
+                                cs->name ? cs->name : "unknown", cs->vdso_clock_mode);
+                        cs->vdso_clock_mode = VDSO_CLOCKMODE_ARCHTIMER;
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'curr_clocksource'\n");
+                    }
+                }
+
+                {
+                    enum vdso_clock_mode *vd_default =
+                        (enum vdso_clock_mode *)ksu_cpu_spoof_lookup_symbol("vdso_default");
+
+                    if (vd_default) {
+                        *vd_default = VDSO_CLOCKMODE_ARCHTIMER;
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'vdso_default'\n");
+                    }
+                }
+
+                {
+                    unsigned long *caps = (unsigned long *)ksu_cpu_spoof_lookup_symbol("cpu_hwcaps");
+
+                    if (!caps)
+                        caps = (unsigned long *)ksu_cpu_spoof_lookup_symbol("system_cpucaps");
+                    if (caps) {
+                        pr_info("ksu: set_spoof_cpu ARM64_WORKAROUND_1418040 before: %d\n",
+                                test_bit(ARM64_WORKAROUND_1418040, caps));
+                        clear_bit(ARM64_WORKAROUND_1418040, caps);
+                        pr_info("ksu: set_spoof_cpu ARM64_WORKAROUND_1418040 after: %d\n",
+                                test_bit(ARM64_WORKAROUND_1418040, caps));
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'cpu_hwcaps'/'system_cpucaps'\n");
+                    }
+                }
+            }
+        }
+    }
+#else
+    return -EOPNOTSUPP;
+#endif
+
+    pr_info("KernelSU: CPU %u cached identity updated (MIDR: 0x%08x)\n",
+            cmd->cpu_index, cmd->midr);
+    return 0;
+}
