+/* Runtime CPU identity spoofing parameters (KSU_IOCTL_SET_SPOOF_CPU). */
+struct ksu_set_spoof_cpu_cmd {
+    __u32 cpu_index; /* Target logical CPU index */
+    __u32 midr;      /* MIDR value, e.g. 0x413fd0c1 */
+    __u32 bogomips;  /* BogoMIPS value in hundredths */
+    __u64 hwcap;     /* Primary ELF HWCAP mask */
+    __u64 hwcap2;    /* Secondary ELF HWCAP2 mask */
+};
+
