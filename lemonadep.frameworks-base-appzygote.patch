# Android 17 / LineageOS 24.0 / OnePlus 9 Pro (lemonadep)
# AppZygote isolated-UID range selection fix.
#
# Root cause:
# UID allocation previously selected mGlobalAppIsolatedUids when the SafeSetID
# policy file existed, even if getUidTransitionPolicy() failed to initialize.
# AppZygote creation required a non-null policy and then looked up the per-app
# range, which was absent because the UID had been allocated globally. This
# caused uidRange.mFirstUid to throw a NullPointerException.
#
# Fix:
# Use one policy-initialization predicate for allocation, AppZygote creation,
# and cleanup. Failed SafeSetID policy initialization consistently falls back
# to the per-AppZygote range allocator. Add a defensive non-null check so any
# future bookkeeping mismatch is reported as a controlled process-start error
# rather than a system_server NullPointerException.
#
# Apply from the root of LineageOS/android_frameworks_base at lineage-24.0:
#   git apply --check lemonadep.frameworks-base-appzygote.patch
#   git apply lemonadep.frameworks-base-appzygote.patch
#
diff --git a/services/core/java/com/android/server/am/ProcessList.java b/services/core/java/com/android/server/am/ProcessList.java
--- a/services/core/java/com/android/server/am/ProcessList.java
+++ b/services/core/java/com/android/server/am/ProcessList.java
@@ -435,9 +435,23 @@
             }
         }
 
-        return mUidTransitionPolicy;
-    }
-
+        return mUidTransitionPolicy;
+    }
+
+    /**
+     * Whether AppZygotes use the shared SafeSetID isolated UID range.
+     *
+     * Keep UID allocation, AppZygote creation, and cleanup on the same
+     * decision. If policy initialization fails, all paths fall back to the
+     * per-AppZygote range allocator.
+     */
+    @GuardedBy("mService")
+    private boolean isAppZygoteUidPolicyEnabledLocked() {
+        return Flags.useSafesetidUidPolicy2()
+                && UidTransitionPolicy.isEnabled()
+                && getUidTransitionPolicy() != null;
+    }
+
