# Android 17 / LineageOS 24.0 / OnePlus 9 Pro (lemonadep)
# AppZygote isolated UID-range selection fix.
# Keep UID allocation, AppZygote range construction and UID cleanup on the
# same successfully initialized SafeSetID policy predicate. If initialization
# fails, all paths consistently use the per-AppZygote allocator. A defensive
# null check prevents a bookkeeping mismatch from crashing system_server.
#
# Apply at the root of LineageOS/android_frameworks_base (lineage-24.0):
# git apply --check lemonadep.frameworks-base-appzygote.patch
# git apply lemonadep.frameworks-base-appzygote.patch
#
diff --git a/services/core/java/com/android/server/am/ProcessList.java b/services/core/java/com/android/server/am/ProcessList.java
