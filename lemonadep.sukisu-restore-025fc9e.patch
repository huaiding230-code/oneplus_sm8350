# Restore the SukiSU builtin-new SELinux compatibility base to the source
# captured from the successful 2026-11-27 build (025fc9e5609add390d7490c24d8a2afafaceff8e).
# The upstream builtin-new ref later moved to 8014fc95df9df1703b2bdc7c6924b4402fb4fa7a,
# which rewrote the SELinux compatibility files and made lemonadep.sukisu-new.patch fail.
# Apply this patch in the SukiSU source root AFTER checkout and BEFORE
# lemonadep.sukisu-new.patch. It only restores the seven captured files listed below;
# it does not pin or change the upstream Git ref and does not replace the adaptation patch.
#
diff --git a/kernel/Makefile b/kernel/Makefile
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -106,6 +106,27 @@
 
 ifeq ($(shell grep -q "struct selinux_state " $(srctree)/security/selinux/include/security.h; echo $$?),0)
 CFLAGS_ksu.o += -DKSU_COMPAT_HAS_SELINUX_STATE
+endif
+
+# 5.10+ selinux_policy (and vendor backports): policy is an RCU protected
+# immutable object guarded by policy_mutex. Probe for the struct itself, not
+# for policy_mutex alone: a tree can carry one without the other.
+KSU_HAVE_SELINUX_POLICY_STRUCT := $(shell grep -q "struct selinux_policy {" $(srctree)/security/selinux/ss/services.h 2>/dev/null && echo y)
+ifeq ($(KSU_HAVE_SELINUX_POLICY_STRUCT),)
+KSU_HAVE_SELINUX_POLICY_STRUCT := $(shell grep -q "struct mutex policy_mutex" $(srctree)/security/selinux/include/security.h 2>/dev/null && echo y)
+endif
+ifeq ($(KSU_HAVE_SELINUX_POLICY_STRUCT),y)
+CFLAGS_ksu.o += -DKSU_COMPAT_HAS_SELINUX_POLICY_STRUCT
+endif
+
+# very old trees define policy_rwlock as a global symbol, so a direct extern
+# reference links. Stock trees keep it file static, see the kallsyms fallback.
+ifeq ($(shell grep -q "^DEFINE_RWLOCK(policy_rwlock);" $(srctree)/security/selinux/ss/services.c 2>/dev/null; echo $$?),0)
+CFLAGS_ksu.o += -DKSU_COMPAT_HAS_EXPORTED_POLICY_RWLOCK
+endif
+
+ifeq ($(shell grep -q "^u32 latest_granting;" $(srctree)/security/selinux/ss/services.c 2>/dev/null; echo $$?),0)
+CFLAGS_ksu.o += -DKSU_COMPAT_HAS_GLOBAL_LATEST_GRANTING
 endif
 
 # UL, look for iterate_dir on ‎fs/readdir.c
diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -28,199 +28,645 @@
  *  our goal for this one is to be self contained as much as possible
  *  with only one call from ksu's initcall.
  *
+ *  The hidden type/rule list is immutable, RCU published and only replaced as
+ *  a whole. The previous hazard pointer implementation had to busy wait on
+ *  every CPU and even called kick_all_cpus_sync() in the read path, which is
+ *  both slow and broken on PREEMPT_RT / !SMP builds.
  */
 
-// enabled by default
-static bool ksu_selinux_hide_enabled __read_mostly = true;
-
-// selinux_setprocattr handler
-static __always_inline int ksu_hide_setprocattr_inline(const char *name, void *value, size_t size)
-{
+/* enabled by default */
+bool ksu_selinux_hide_enabled __read_mostly = true;
+
+/* the page we serve to unprivileged readers of /sys/fs/selinux/status */
+struct page *ksu_fake_status_page __read_mostly = NULL;
+
+struct ksu_sepol_hide_set {
+	struct rcu_head rcu;
+	u32 count;
+	size_t len;
+	char data[];
+};
+
+static struct ksu_sepol_hide_set __rcu *ksu_hide_types __read_mostly;
+static struct ksu_sepol_hide_set __rcu *ksu_hide_rules __read_mostly;
+static DEFINE_MUTEX(ksu_hide_list_lock);
+
+/* selinuxfs nodes, resolved once before any hook is installed */
+static struct inode *ksu_sel_context_inode __read_mostly;
+static struct inode *ksu_sel_access_inode __read_mostly;
+static struct file_operations *ksu_sel_context_fops __read_mostly;
+static struct file_operations *ksu_sel_access_fops __read_mostly;
+
+static void ksu_maybe_resolve_selinuxfs_nodes(void);
+
+static void ksu_sepol_hide_free_rcu(struct rcu_head *head)
+{
+	kfree(container_of(head, struct ksu_sepol_hide_set, rcu));
+}
+
+static struct ksu_sepol_hide_set *ksu_sepol_hide_set_grow(const struct ksu_sepol_hide_set *cur,
+							  size_t add)
+{
+	struct ksu_sepol_hide_set *new_set;
+	size_t len = cur ? cur->len : 0;
+	size_t total;
+
+	if (add > (size_t)-1 - sizeof(*new_set) - len)
+		return NULL;
+
+	total = sizeof(*new_set) + len + add;
+	new_set = kmalloc(total, GFP_KERNEL);
+	if (!new_set)
+		return NULL;
+
+	new_set->count = cur ? cur->count : 0;
+	new_set->len = len + add;
+	if (cur && len)
+		memcpy(new_set->data, cur->data, len);
+
+	return new_set;
+}
+
+static bool ksu_sepol_hide_set_contains(const struct ksu_sepol_hide_set *set,
+					const char *name, size_t len)
+{
+	size_t off = 0;
+	u32 i;
+
+	if (!set || !len)
+		return false;
+
+	for (i = 0; i < set->count && off < set->len; i++) {
+		const char *cur = set->data + off;
+		size_t cur_len = strlen(cur);
+
+		if (cur_len == len && !memcmp(cur, name, len))
+			return true;
+
+		off += cur_len + 1;
+	}
+
+	return false;
+}
+
+static bool ksu_sepol_hide_rule_contains(const struct ksu_sepol_hide_set *set,
+					 const char *src, size_t src_len,
+					 const char *tgt, size_t tgt_len)
+{
+	size_t off = 0;
+	u32 i;
+
+	if (!set || !src_len || !tgt_len)
+		return false;
+
+	for (i = 0; i < set->count && off < set->len; i++) {
+		const char *cur_src = set->data + off;
+		size_t cur_src_len = strlen(cur_src);
+		const char *cur_tgt;
+		size_t cur_tgt_len;
+
+		off += cur_src_len + 1;
+		if (off >= set->len)
+			break;
+
+		cur_tgt = set->data + off;
+		cur_tgt_len = strlen(cur_tgt);
+		off += cur_tgt_len + 1;
+
+		if (cur_src_len == src_len && !memcmp(cur_src, src, src_len) &&
+		    cur_tgt_len == tgt_len && !memcmp(cur_tgt, tgt, tgt_len))
+			return true;
+	}
+
+	return false;
+}
+
+static void ksu_sepol_hide_publish(struct ksu_sepol_hide_set __rcu **slot,
+				   struct ksu_sepol_hide_set *new_set)
+{
+	struct ksu_sepol_hide_set *old;
+
+	old = rcu_dereference_protected(*slot, lockdep_is_held(&ksu_hide_list_lock));
+	rcu_assign_pointer(*slot, new_set);
+	if (old)
+		call_rcu(&old->rcu, ksu_sepol_hide_free_rcu);
+}
+
+void ksu_selinux_hide_add_type(const char *type)
+{
+	struct ksu_sepol_hide_set *cur, *new_set;
+	char *dst;
+	size_t len;
+
+	if (!type)
+		return;
+
+	len = strlen(type);
+	/* a type name is a single token: no ':' / whitespace allowed */
+	if (!len || len > 255 || memchr(type, ':', len) || memchr(type, ' ', len) ||
+	    memchr(type, '\t', len))
+		return;
+
+	mutex_lock(&ksu_hide_list_lock);
+
+	cur = rcu_dereference_protected(ksu_hide_types, lockdep_is_held(&ksu_hide_list_lock));
+	if (ksu_sepol_hide_set_contains(cur, type, len))
+		goto out_unlock;
+
+	new_set = ksu_sepol_hide_set_grow(cur, len + 1);
+	if (!new_set)
+		goto out_unlock;
+
+	dst = new_set->data + (cur ? cur->len : 0);
+	memcpy(dst, type, len);
+	dst[len] = '\0';
+	new_set->count++;
+
+	ksu_sepol_hide_publish(&ksu_hide_types, new_set);
+	pr_info("selinux_hide: tracking type %s\n", type);
+
+out_unlock:
+	mutex_unlock(&ksu_hide_list_lock);
+}
+
+void ksu_selinux_hide_add_rule(const char *src, const char *tgt)
+{
+	struct ksu_sepol_hide_set *cur, *new_set;
+	char *dst;
+	size_t src_len, tgt_len;
+
+	if (!src || !tgt)
+		return;
+
+	src_len = strlen(src);
+	tgt_len = strlen(tgt);
+	if (!src_len || !tgt_len || src_len > 255 || tgt_len > 255 ||
+	    memchr(src, ':', src_len) || memchr(tgt, ':', tgt_len))
+		return;
+
+	mutex_lock(&ksu_hide_list_lock);
+
+	cur = rcu_dereference_protected(ksu_hide_rules, lockdep_is_held(&ksu_hide_list_lock));
+	if (ksu_sepol_hide_rule_contains(cur, src, src_len, tgt, tgt_len))
+		goto out_unlock;
+
+	new_set = ksu_sepol_hide_set_grow(cur, src_len + 1 + tgt_len + 1);
+	if (!new_set)
+		goto out_unlock;
+
+	dst = new_set->data + (cur ? cur->len : 0);
+	memcpy(dst, src, src_len);
+	dst[src_len] = '\0';
+	memcpy(dst + src_len + 1, tgt, tgt_len);
+	dst[src_len + 1 + tgt_len] = '\0';
+	new_set->count++;
+
+	ksu_sepol_hide_publish(&ksu_hide_rules, new_set);
+	pr_info("selinux_hide: tracking rule %s %s\n", src, tgt);
+
+out_unlock:
+	mutex_unlock(&ksu_hide_list_lock);
+}
+
+/*
+ * Translates an applied sepolicy command into hide list entries.
+ *
+ * GENFSCON takes (name, path, context) - the second argument is a path, not a
+ * type, so it must not be turned into a rule pair (the old argc based code did
+ * exactly that and poisoned the rule list with garbage).
+ */
+void ksu_add_shit_to_list(u32 cmd, const char *const args[])
+{
+	if (!args || !args[0])
+		return;
+
+	switch (cmd) {
+	case KSU_SEPOLICY_CMD_TYPE:
+	case KSU_SEPOLICY_CMD_TYPE_ATTR:
+	case KSU_SEPOLICY_CMD_TYPE_STATE:
+	case KSU_SEPOLICY_CMD_ATTR:
+		ksu_selinux_hide_add_type(args[0]);
+		break;
+	case KSU_SEPOLICY_CMD_NORMAL_PERM:
+	case KSU_SEPOLICY_CMD_XPERM:
+	case KSU_SEPOLICY_CMD_TYPE_TRANSITION:
+	case KSU_SEPOLICY_CMD_TYPE_CHANGE:
+		if (args[1])
+			ksu_selinux_hide_add_rule(args[0], args[1]);
+		break;
+	default:
+		break;
+	}
+}
+
+/*
+ * SELinux context      : user:role:type[:mls]
+ * avc audit record      : ... scontext=user:role:type:mls tcontext=...
+ * selinuxfs access node : "scon tcon class perms"
+ * single context        : user:role:type:mls
+ *
+ * Return the type field and its length, NULL if this is not a context.
+ */
+static const char *ksu_sepol_ctx_type(const char *s, size_t len, size_t *type_len)
+{
+	const char *p = s;
+	const char *end = s + len;
+	const char *type = NULL;
+	int colons = 0;
+
+	while (p < end && *p) {
+		if (*p == ':') {
+			colons++;
+			if (colons == 2) {
+				type = p + 1;
+				break;
+			}
+		}
+		p++;
+	}
+
+	if (colons != 2)
+		return NULL;
+
+	p = type;
+	while (p < end && *p && *p != ':')
+		p++;
+
+	/* a context always has an MLS/level field after the type */
+	if (p >= end || *p != ':' || p == type)
+		return NULL;
+
+	*type_len = p - type;
+	return type;
+}
+
+static const char *ksu_sepol_find_value(const char *s, size_t len, const char *tag,
+					size_t *value_len)
+{
+	size_t tag_len = strlen(tag);
+	size_t i;
+
+	if (!s || len <= tag_len)
+		return NULL;
+
+	for (i = 0; i + tag_len < len; i++) {
+		const char *value;
+		size_t value_size = 0;
+
+		if (s[i] != tag[0] || memcmp(s + i, tag, tag_len))
+			continue;
+
+		value = s + i + tag_len;
+		while (i + tag_len + value_size < len && value[value_size] &&
+		       value[value_size] != ' ' && value[value_size] != '\t' &&
+		       value[value_size] != '\n' && value[value_size] != '\r')
+			value_size++;
+
+		if (!value_size)
+			return NULL;
+
+		*value_len = value_size;
+		return value;
+	}
+
+	return NULL;
+}
+
+static void ksu_sepol_extract_contexts(const char *str, size_t limit,
+				       const char **sctx, size_t *sctx_len,
+				       const char **tctx, size_t *tctx_len)
+{
+	const char *p, *end = str + limit;
+	size_t len;
+
+	*sctx = ksu_sepol_find_value(str, limit, "scontext=", sctx_len);
+	*tctx = ksu_sepol_find_value(str, limit, "tcontext=", tctx_len);
+	if (*sctx || *tctx)
+		return;
+
+	/* plain "scon tcon class perm" (selinuxfs access/relabel/user nodes) */
+	p = str;
+	while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r'))
+		p++;
+
+	len = 0;
+	while (p + len < end && p[len] && p[len] != ' ' && p[len] != '\t' &&
+	       p[len] != '\n' && p[len] != '\r')
+		len++;
+	if (!len)
+		return;
+
+	*sctx = p;
+	*sctx_len = len;
+
+	p += len;
+	while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r'))
+		p++;
+
+	len = 0;
+	while (p + len < end && p[len] && p[len] != ' ' && p[len] != '\t' &&
+	       p[len] != '\n' && p[len] != '\r')
+		len++;
+	if (!len)
+		return;
+
+	*tctx = p;
+	*tctx_len = len;
+}
+
+bool ksu_should_destroy_context(const char *str, size_t limit, bool types_only)
+{
+	const struct ksu_sepol_hide_set *types;
+	const struct ksu_sepol_hide_set *rules;
+	const char *sctx = NULL, *tctx = NULL;
+	const char *stype = NULL, *ttype = NULL;
+	size_t sctx_len = 0, tctx_len = 0;
+	size_t stype_len = 0, ttype_len = 0;
+	bool hit = false;
+
+	if (!str || !limit)
+		return false;
+
+	ksu_sepol_extract_contexts(str, limit, &sctx, &sctx_len, &tctx, &tctx_len);
+
+	if (sctx)
+		stype = ksu_sepol_ctx_type(sctx, sctx_len, &stype_len);
+	if (tctx)
+		ttype = ksu_sepol_ctx_type(tctx, tctx_len, &ttype_len);
+	if (!stype)
+		return false;
+
+	rcu_read_lock();
+
+	types = rcu_dereference(ksu_hide_types);
+	if (types && ksu_sepol_hide_set_contains(types, stype, stype_len)) {
+		hit = true;
+		goto out;
+	}
+
+	if (types_only)
+		goto out;
+
+	if (types && ttype && ksu_sepol_hide_set_contains(types, ttype, ttype_len)) {
+		hit = true;
+		goto out;
+	}
+
+	rules = rcu_dereference(ksu_hide_rules);
+	if (rules && ttype &&
+	    ksu_sepol_hide_rule_contains(rules, stype, stype_len, ttype, ttype_len))
+		hit = true;
+
+out:
+	rcu_read_unlock();
+	return hit;
+}
