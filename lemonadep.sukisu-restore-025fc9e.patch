+	if (!inode)
+		return false;
+
+	if (unlikely(!READ_ONCE(ksu_sel_access_inode)))
+		ksu_maybe_resolve_selinuxfs_nodes();
+
+	return inode == READ_ONCE(ksu_sel_access_inode);
+}
