+/*
+ * security_compute_av_user() stamps every /sys/fs/selinux/access reply with the
+ * current policy generation. Publish the boot time value instead so an app
+ * cannot tell that the policy has been patched by simply reading it back.
+ */
+static ssize_t ksu_selinux_hide_fake_access_seqno(struct file *file, ssize_t ret)
