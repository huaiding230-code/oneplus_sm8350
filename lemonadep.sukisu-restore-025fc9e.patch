+/*
+ * Policy file header layout:
+ *   u32 magic, u32 strlen("SE Linux"), char[8] "SE Linux", u32 policyvers,
+ *   u32 config.
+ * so the config word lives at byte 8 + 8 + 4 = 20.
+ */
+#define KSU_POLICY_CONFIG_OFFSET	20
+#define KSU_POLICY_MIN_SIZE		(4U * 1024U)
+#define KSU_POLICY_MAX_SIZE		(32U * 1024U * 1024U)
+#define KSU_POLICY_GROW_RETRIES		4
+
+#if defined(POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE) || defined(POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH)
+/*
+ * https://android.googlesource.com/kernel/common/+/35a7845718734ae638b85b420534cb859498dab6%5E%21
+ * https://android-review.googlesource.com/c/kernel/common/+/3009995/11/security/selinux/ss/policydb.c
+ *
+ * These kernels do not round trip the android specific config bits through
+ * policydb_write(), so restore the ones the live policy had.
+ */
+static void ksu_policydb_fixup_config(struct policydb *db, void *data, size_t serialized)
+{
+	u32 *config;
+
+	if (serialized < KSU_POLICY_CONFIG_OFFSET + sizeof(u32))
+		return;
+
+	config = (u32 *)((unsigned long)data + KSU_POLICY_CONFIG_OFFSET);
+
+#ifdef POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE
+	if (db->android_netlink_route)
+		*config |= POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE;
+#endif
+#ifdef POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH
+	if (db->android_netlink_getneigh)
+		*config |= POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH;
+#endif
+}
+#else
+static void ksu_policydb_fixup_config(struct policydb *db, void *data, size_t serialized)
+{
+}
+#endif
+
+size_t ksu_policydb_size_hint(const struct policydb *db)
+{
+	size_t len;
+
+	/*
+	 * Some device policy db seems not marking type itself in
+	 * type_attr_map_array: policydb_read() adds each type to its own
+	 * attribute map, so db->len can be smaller than what re-serializing
+	 * the policy needs. Keep one ebitmap entry per type as slack.
+	 */
+	len = (size_t)db->len + (size_t)db->p_types.nprim * (sizeof(u32) + sizeof(u64));
+
+	if (len < KSU_POLICY_MIN_SIZE)
+		len = KSU_POLICY_MIN_SIZE;
+
+	return len;
+}
+
+/*
+ * Serialize db into a caller provided buffer.
+ *
+ * Deliberately allocation free: the legacy install path runs this with
+ * policy_rwlock held for reading, where sleeping (kvmalloc/policydb_read) is
+ * illegal. Returns the number of bytes written, or -EINVAL if the buffer is
+ * too small.
+ */
+ssize_t ksu_policydb_serialize(struct policydb *db, void *buf, size_t buflen)
+{
+	struct policy_file fp;
+	size_t serialized;
+
+	fp.data = buf;
+	fp.len = buflen;
+
+	if (policydb_write(db, &fp))
+		return -EINVAL;
+
+	serialized = buflen - fp.len;
+	ksu_policydb_fixup_config(db, buf, serialized);
+
+	return (ssize_t)serialized;
+}
+
+/*
+ * Parse a serialized policy into an already zeroed policydb. Allocates the
+ * policy tables, so it must run in process context without any lock held.
+ */
+int ksu_policydb_parse(struct policydb *db, void *buf, size_t len)
+{
+	struct policy_file fp;
+
+	fp.data = buf;
+	fp.len = len;
+
+	if (policydb_read(db, &fp))
+		return -EINVAL;
+
+	db->len = (unsigned int)len;
+
+	return 0;
+}
+
+/*
+ * Deep copy for callers that can guarantee the source db cannot be swapped
+ * while it is read (5.10+ keeps the policy alive through RCU).
+ */
+int ksu_policydb_dup(struct policydb *old_db, struct policydb *new_db)
+{
+	ssize_t serialized;
+	size_t cap;
+	void *data;
+	int grow, ret;
+
+	cap = ksu_policydb_size_hint(old_db);
+
+	for (grow = 0; grow < KSU_POLICY_GROW_RETRIES; grow++) {
+		data = kvmalloc(cap, GFP_KERNEL);
+		if (!data)
+			return -ENOMEM;
+
+		serialized = ksu_policydb_serialize(old_db, data, cap);
+		if (serialized >= 0) {
+			ret = ksu_policydb_parse(new_db, data, (size_t)serialized);
+			kvfree(data);
+			return ret;
+		}
+
+		kvfree(data);
+
+		if (cap > KSU_POLICY_MAX_SIZE / 2)
+			break;
+		cap *= 2;
+	}
+
+	pr_err("sepolicy: policydb_write: buffer too small\n");
+
+	return -EINVAL;
+}
