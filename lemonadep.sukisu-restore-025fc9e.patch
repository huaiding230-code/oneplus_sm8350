+
+/*
+ * Take an immutable snapshot of the live policy.
+ *
+ * policy_rwlock disables preemption, so everything that can sleep (the
+ * serialization buffer, policydb_read) happens outside of it: the buffer is
+ * allocated first, then serialized under the read lock, and only afterwards
+ * parsed into the private copy. If the snapshot grew past the buffer the whole
+ * thing is retried with a bigger one.
+ */
+static int ksu_policydb_snapshot(struct policydb *live, rwlock_t *lock,
+				 struct policydb *next, u32 *generation)
+{
+	ssize_t serialized;
+	size_t cap;
+	void *buf;
+	int grow, ret;
+
+	cap = ksu_policydb_size_hint(live);
+
+	for (grow = 0; grow < 4; grow++) {
+		buf = kvmalloc(cap, GFP_KERNEL);
+		if (!buf)
+			return -ENOMEM;
+
+		read_lock(lock);
+		*generation = READ_ONCE(*ksu_get_latest_granting());
+		serialized = ksu_policydb_serialize(live, buf, cap);
+		read_unlock(lock);
+
+		if (serialized >= 0) {
+			ret = ksu_policydb_parse(next, buf, (size_t)serialized);
+			kvfree(buf);
+			return ret;
+		}
+
+		kvfree(buf);
+
+		/* buffer too small, try again with twice the room */
+		if (cap > (32U * 1024U * 1024U) / 2)
+			break;
+		cap *= 2;
+	}
+
+	pr_err("kernelsu: unable to snapshot the running policy\n");
+
+	return -EINVAL;
+}
+
+/*
+ * Clone -> mutate -> swap. The clone is taken with the read lock held so it
+ * can never observe a half swapped table, the mutation runs on private memory
+ * and the (tiny, allocation free) struct swap happens under the write lock.
+ *
+ * If userspace managed to load a policy between our clone and the swap, the
+ * generation number moved and we simply retry with a fresh clone.
+ */
+static int ksu_replace_policy_legacy(ksu_policydb_mutator mutate, void *arg)
+{
+	struct policydb *live = ksu_get_policydb();
+	rwlock_t *lock;
+	struct policydb *next, *old;
+	u32 generation = 0;
+	bool next_loaded = false;
+	int attempt;
+	int ret;
+
+#if !defined(KSU_COMPAT_USE_SELINUX_STATE)
+	if (!ksu_get_policy_rwlock() || !ksu_get_latest_granting()) {
+		if (ksu_resolve_legacy_policy_symbols())
+			return -EOPNOTSUPP;
+	}
+#endif
+
+	lock = ksu_get_policy_rwlock();
+	if (!lock || !ksu_get_latest_granting())
+		return -EOPNOTSUPP;
+
+	/* no policy loaded yet, nothing to patch */
+	if (!READ_ONCE(live->len))
+		return -EAGAIN;
+
+	next = kzalloc(sizeof(*next), GFP_KERNEL);
+	old = kmalloc(sizeof(*old), GFP_KERNEL);
+	if (!next || !old) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = -EAGAIN;
+	for (attempt = 0; attempt < KSU_POLICY_SWAP_RETRIES; attempt++) {
+		ret = ksu_policydb_snapshot(live, lock, next, &generation);
+		if (ret < 0)
+			goto out;
+
+		next_loaded = true;
+
+		ret = mutate(next, arg);
+		if (ret < 0) {
+			ksu_policydb_reset(next);
+			next_loaded = false;
+			goto out;
+		}
+
+		write_lock_irq(lock);
+		if (READ_ONCE(*ksu_get_latest_granting()) != generation) {
+			write_unlock_irq(lock);
+			ksu_policydb_reset(next);
+			next_loaded = false;
+			cond_resched();
+			continue;
+		}
+
+		/* The readers only ever see the whole struct, never a mix. */
+		memcpy(old, live, sizeof(*old));
+		memcpy(live, next, sizeof(*next));
+		memset(next, 0, sizeof(*next));
+		next_loaded = false;
+		WRITE_ONCE(*ksu_get_latest_granting(), generation + 1);
+		write_unlock_irq(lock);
+
+		/* tables that belonged to the old policy, safe to free unlocked */
+		ksu_policydb_reset(old);
+
+		/* flush the avc so the freshly added rules are actually used */
+		reset_avc_cache(generation + 1);
+		ret = 0;
+		goto out;
+	}
+
+	pr_err("kernelsu: policy is being reloaded concurrently, giving up after %d attempts\n",
+	       KSU_POLICY_SWAP_RETRIES);
+	ret = -EAGAIN;
+
+out:
+	if (next_loaded)
+		ksu_policydb_reset(next);
+	kfree(next);
+	kfree(old);
+	return ret;
+}
