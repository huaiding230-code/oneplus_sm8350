+bool ksu_selinux_hide_is_context_inode(const struct inode *inode)
+{
+	if (!inode)
+		return false;
+
+	if (unlikely(!READ_ONCE(ksu_sel_context_inode)))
+		ksu_maybe_resolve_selinuxfs_nodes();
+
+	return inode == READ_ONCE(ksu_sel_context_inode);
+}
+
+bool ksu_selinux_hide_is_access_inode(const struct inode *inode)
